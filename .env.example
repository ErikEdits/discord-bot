DISCORD_BOT_TOKEN=paste_your_bot_token_here

# Web panel
PANEL_PASSWORD=change_me_please
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
PANEL_ENABLED=true

# Tuning - higher value spreads /setup/reset over more time (gentler on CPU)
SETUP_THROTTLE_SECONDS=0.6

# Anti-spam needs this AND the Message Content toggle in the Developer Portal
MESSAGE_CONTENT_INTENT=true

# Optional fallbacks - normally set these in Discord with /settings bug-webhook
# and /settings backup-webhook (those win over the values here).
BUG_WEBHOOK_URL=
BACKUP_WEBHOOK_URL=

# Optional: Discord user ID that receives poll results by DM (default: bot owner)
OWNER_ID=

# Web panel "Login with Discord" (recommended). Only members with the Administrator
# permission on the server can log in. Developer Portal -> your app -> OAuth2:
# copy the Client Secret here and add <PANEL_PUBLIC_URL>/oauth/callback as a Redirect.
DISCORD_CLIENT_SECRET=
# The address you open the panel with, e.g. http://localhost:8080 or https://panel.example.com
PANEL_PUBLIC_URL=
# With Discord login set up, the password login is off. Set to true to keep both.
PANEL_ALLOW_PASSWORD=false
